# Per-project env vars override the hash and signing secret embedded in lib/projects.ts.
# Use these if the repo is PUBLIC so secrets stay out of source.
#
# Naming: <PROJECT_ENV_PREFIX>PASSWORD and <PROJECT_ENV_PREFIX>SECRET.
# Each project declares its own envVarPrefix in lib/projects.ts.

# Real estate (envVarPrefix = "RE_")
RE_PASSWORD=
RE_SECRET=
