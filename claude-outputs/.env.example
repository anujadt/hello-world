# Optional env vars. The site works without them if the repo stays PRIVATE.
# Set these in Vercel project settings (Settings -> Environment Variables) if the
# repo is PUBLIC so that the password hash and signing secret are NOT in source.

# Plaintext site password. Overrides the build-time hash in lib/auth.ts.
SITE_PASSWORD=

# 32+ byte hex string. Overrides the session signing secret in lib/auth.ts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_SECRET=
